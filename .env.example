# QRAFT environment variables template
# Copy this file to `.env.local` for local development.
# For Vercel: add these in Project → Settings → Environment Variables.
# NEVER commit real secrets.

# ------------------------------------------------------------------
# MongoDB connection string (Atlas/local). Required.
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qraft
# In Atlas, "Database Access" must list this IP (0.0.0.0/0 for Vercel) and the
# database must be named "qraft" (or update the path below).
MONGODB_URI=""

# ------------------------------------------------------------------
# NextAuth v5 secret — used to sign/verify session JWTs. Required.
# Generate with: openssl rand -base64 32
# On Vercel use the Production environment value (never Preview).
AUTH_SECRET=""

# ------------------------------------------------------------------
# OPTIONAL — comma-separated list of hosts the dynamic-QR redirect engine is
# allowed to send users to. Example: "example.com,company.com"
# If left empty, any http(s) host is allowed (scheme restrictions still apply).
REDIRECT_ALLOWED_HOSTS=""

# ------------------------------------------------------------------
# Firebase Storage — required for PDF/document uploads.
# PDFs upload DIRECTLY from the browser to Firebase Storage (bypassing Vercel's
# 4.5MB serverless request limit), so they don't go through a Next.js API route.
#
# Get these from the Firebase Console:
#   Project Settings (gear) → General → Your apps → Web app → SDK setup/config.
# Then create a Storage bucket under Build → Storage (start in test mode, then
# switch to the storage rules shown in the README).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ------------------------------------------------------------------
# VERCEL QUICKSTART
# 1. Push this repo to GitHub and import it in Vercel (Framework: Next.js, Build: npm run build).
# 2. In Project Settings → Environment Variables, add:
#      MONGODB_URI, AUTH_SECRET (Production), and all NEXT_PUBLIC_FIREBASE_* vars.
#    Note: NEXT_PUBLIC_* variables are embedded in the client bundle, so add them
#    for BOTH Production and Preview environments.
# 3. In MongoDB Atlas → Network Access, allow access from anywhere (0.0.0.0/0).
# 4. In Firebase → Build → Storage, keep/verify the rules allow public read of
#    the /qrfiles/ path and authenticated/any write (see rule example below).
# 5. Deploy.

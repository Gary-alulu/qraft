# QRAFT environment variables template
# Copy this file to `.env.local` for local development.
# For Vercel: add these in Project → Settings → Environment Variables.
# NEVER commit real secrets.

# ------------------------------------------------------------------
# MongoDB connection string (Atlas/local). Required.
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qraft
# In Atlas, "Database Access" must list this IP (0.0.0.0/0 for Vercel) and the
# database must be named "qraft" (or update the path below).
MONGODB_URI=""

# ------------------------------------------------------------------
# SUPABASE — required for ALL authentication (email/password + OAuth with
# Google, GitHub, Discord, X/Twitter) and for PDF document storage.
#
# Get these from the Supabase dashboard:
#   Project Settings (gear) → API → Project URL + anon public key.
# Then, to enable sign-in methods:
#   Authentication → Sign In / Providers → Email (and toggle Google, GitHub,
#   Discord, Twitter) — follow the dashboard prompts to paste each provider's
#   OAuth client id/secret. No code changes are needed per provider.
#
# Add these to the DNS allow-list in Supabase → Authentication → URL
# Configuration:
#   Site URL / Redirect URLs:  http://localhost:3000  (dev)
#                              https://<your-domain>.vercel.app  (prod)
# And add the app's post-OAuth redirect URL:
#   http://localhost:3000/api/auth/callback
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase SERVICE_ROLE key (secret — NEVER expose to the browser / never
# prefix with NEXT_PUBLIC_). Used server-side to mint signed upload URLs.
#   Project Settings → API → service_role (or Secret key).
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------
# OPTIONAL — comma-separated list of hosts the dynamic-QR redirect engine is
# allowed to send users to. Example: "example.com,company.com"
# If left empty, any http(s) host is allowed (scheme restrictions still apply).
REDIRECT_ALLOWED_HOSTS=""

# Supabase Storage — PDFs upload DIRECTLY from the browser to Supabase Storage
# (bypassing Vercel's 4.5MB serverless request limit). Create a public bucket
# named "pdf" (lowercase) under Storage. Uses the Supabase vars above.

# ------------------------------------------------------------------
# OPTIONAL — secret protecting the document auto-delete cron endpoint.
# Set this on Vercel so /api/cron/cleanup-documents is only callable by the
# scheduled job (Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ------------------------------------------------------------------
# OPTIONAL — Email delivery provider (Brevo).
# If not configured, emails run in Dev/Preview mode (viewable at /api/notifications/test-email).
# Free plan: 300 emails/day, no credit card required. Get an API key at https://brevo.com
BREVO_API_KEY=""
EMAIL_FROM="Qraft Alerts <alerts@qraft.app>"

# ------------------------------------------------------------------
# VERCEL QUICKSTART
# 1. Push this repo to GitHub and import it in Vercel (Framework: Next.js, Build: npm run build).
# 2. In Project Settings → Environment Variables, add:
#      MONGODB_URI, AUTH_SECRET (Production), and both NEXT_PUBLIC_SUPABASE_* vars.
#    Note: NEXT_PUBLIC_* variables are embedded in the client bundle, so add
#    them for BOTH Production and Preview environments.
# 3. In MongoDB Atlas → Network Access, allow access from anywhere (0.0.0.0/0).
# 4. In Supabase → Storage, create a public bucket named "documents".
# 5. Deploy.

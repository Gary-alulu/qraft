# QRAFT environment variables template
# Copy this file to `.env.local` (for local dev) or set these in your
# deployment platform's environment settings. NEVER commit real secrets.

# MongoDB connection string (Atlas/local). Example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qraft
MONGODB_URI=""

# NextAuth v5 secret — used to sign/verify session JWTs.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# If AUTH_SECRET is not provided at runtime, a secure value is auto-generated
# per-process so sessions never silently use a hardcoded key.

# OPTIONAL — comma-separated list of hosts the dynamic-QR redirect engine is
# allowed to send users to. Example: "example.com,company.com"
# If left empty, any http(s) host is allowed (scheme restrictions still apply).
REDIRECT_ALLOWED_HOSTS=""
